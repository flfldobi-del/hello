<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="cursor-route-roadbike" xmlns="http://www.topografix.com/GPX/1/1">
<metadata>
<name>Forstenried – Riva (Rennrad, nur Asphalt)</name>
<desc>Keine Waldwege. Routing auf asphaltierten Straßen/Radwegen. Freitag 17 Uhr: südlicher Orts-/Landstraßenkorridor statt Forstenrieder Park. Achensee: asphaltierter See-Radweg (Pflicht). Max. kurze Schotter-Brücken (&lt;200m) nur falls lokal nötig.</desc>
</metadata>
